# Environment variables for vibe-collectives
# Copy to .env.local and fill in your values

# Email service (Formspree, Netlify Functions, etc.)
EMAIL_ENDPOINT=https://formspree.io/f/your-form-id

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook

# Direct message endpoint (Telegram bot, Matrix, custom API)
DM_ENDPOINT=https://api.your-domain.com/dm

# Analytics (optional)
ANALYTICS_ID=your-plausible-or-umami-id