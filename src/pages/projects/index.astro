---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
// src/pages/projects/index.astro
import Layout from "../../layouts/Layout.astro";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.status === "published")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="All Projects — vibe-collectives" description="All published projects in the vibe-collectives collection">
  <header class="mb-12">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">All Projects</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Browse all published projects, artifacts, and signals
    </p>
  </header>
  
  <section>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
    
    {projects.length === 0 && (
      <div class="text-center py-12 text-muted-foreground">
        <p class="mb-4">No projects yet.</p>
        <a href="/intake" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent transition-colors">
          Add Your First Project →
        </a>
      </div>
    )}
  </section>
</Layout>