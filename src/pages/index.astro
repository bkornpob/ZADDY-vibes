---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro"
import { getCollection } from "astro:content"
import ProjectCard from "../components/ProjectCard.astro"

const projects = (await getCollection("projects"))
  .filter(p => p.data.status === "published")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
---

<Layout title="vibe-collectives" description="Transmitting corpus to communities — projects, artifacts, and signals">
  <header class="mb-12 text-center">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">
      vibe<span class="text-primary">-</span>collectives
    </h1>
    <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
      Transmitting our corpus to communities — projects, artifacts, and signals
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/projects" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors">
        View All Projects →
      </a>
      <a href="/intake" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent transition-colors">
        Add Project
      </a>
    </div>
  </header>
  
  <section>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
    
    {projects.length === 0 && (
      <div class="text-center py-12 text-muted-foreground">
        <p class="mb-4">No projects yet.</p>
        <a href="/intake" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-md hover:bg-accent transition-colors">
          Add Your First Project →
        </a>
      </div>
    )}
  </section>
</Layout>