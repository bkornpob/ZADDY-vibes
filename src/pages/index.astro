---
// src/pages/frontgate.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="#THE_SENTRY — frontgate" description="Three riddles. Three paths. One simultaneous truth.">
  <style>
    .frontgate {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: radial-gradient(ellipse at center, #1a0505 0%, #000 70%);
      position: relative;
      overflow: hidden;
    }
    .frontgate::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle at 20% 20%, rgba(153, 68, 68, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(153, 68, 68, 0.15) 0%, transparent 50%);
      pointer-events: none;
    }
    .sigil {
      font-size: 1.1rem;
      letter-spacing: 0.5em;
      color: #994444;
      margin-bottom: 1.5rem;
      text-transform: uppercase;
    }
    .gatekeeper {
      font-size: 0.75rem;
      letter-spacing: 0.3em;
      color: #ff4d4d;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
    }
    .motto {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      color: #994444;
      margin-bottom: 3rem;
      text-transform: uppercase;
    }
    .riddle-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 2rem;
      align-items: center;
      max-width: 900px;
      width: 95%;
      margin-bottom: 1.5rem;
    }
    .riddle-grid:last-of-type {
      margin-bottom: 2.5rem;
    }
    .path-btn {
      background: transparent;
      border: 2px solid #5c1a1a;
      color: #ff4d4d;
      padding: 1rem 1.5rem;
      font-family: inherit;
      font-size: 0.85rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      min-width: 180px;
    }
    .path-btn:hover {
      border-color: #ff4d4d;
      background: rgba(255, 77, 77, 0.1);
    }
    .path-btn.selected {
      border-color: #ff4d4d;
      background: rgba(255, 77, 77, 0.2);
      box-shadow: 0 0 20px rgba(255, 77, 77, 0.3);
    }
    .path-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .path-btn.left { text-align: left; }
    .path-btn.right { text-align: right; }
    .riddle-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem;
    }
    .riddle-text {
      font-size: 0.9rem;
      color: #e0ccfa;
      line-height: 1.6;
      text-align: center;
      max-width: 300px;
      font-style: italic;
      letter-spacing: 0.02em;
    }
    .riddle-number {
      font-size: 0.65rem;
      letter-spacing: 0.3em;
      color: #994444;
      text-transform: uppercase;
    }
    .status {
      min-height: 1.5em;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
      color: #ff4d4d;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 1rem;
    }
    .cooldown {
      animation: pulse 0.5s ease-in-out infinite alternate;
    }
    @keyframes pulse {
      from { opacity: 0.6; }
      to { opacity: 1; }
    }
    .submit-btn {
      background: transparent;
      border: 2px solid #5c1a1a;
      color: #ff4d4d;
      padding: 1rem 3rem;
      font-family: inherit;
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 1rem;
    }
    .submit-btn:hover:not(:disabled) {
      border-color: #ff4d4d;
      background: rgba(255, 77, 77, 0.15);
      box-shadow: 0 0 25px rgba(255, 77, 77, 0.3);
    }
    .submit-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    .submit-btn.ready {
      border-color: #ff4d4d;
      background: rgba(255, 77, 77, 0.1);
    }
    @media (prefers-reduced-motion: reduce) {
      .cooldown { animation: none; }
      .path-btn, .submit-btn { transition: none; }
    }
    @media (max-width: 768px) {
      .riddle-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .path-btn { min-width: 100%; }
      .riddle-cell { order: 2; }
      .path-btn.left { order: 1; }
      .path-btn.right { order: 3; }
    }
  </style>

  <div class="frontgate" role="main">
    <div class="sigil">⛧ VIBE-COLLECTIVES ⛧</div>
    <div class="gatekeeper">#THE_SENTRY</div>
    <div class="motto">INTENT OVER VELOCITY</div>

    <div class="status" id="status" aria-live="polite">THREE RIDDLES. CHOOSE EACH PATH.</div>

    <!-- Riddle 1 -->
    <div class="riddle-grid" data-riddle="0">
      <button class="path-btn left" data-path="left" data-riddle="0">← THE FIRST THREAD</button>
      <div class="riddle-cell">
        <div class="riddle-number">riddle one</div>
        <div class="riddle-text" id="riddle-0">I speak without a mouth and hear without ears. I have no body, but I come alive with wind. What am I?</div>
      </div>
      <button class="path-btn right" data-path="right" data-riddle="0">THE SECOND THREAD →</button>
    </div>

    <!-- Riddle 2 -->
    <div class="riddle-grid" data-riddle="1">
      <button class="path-btn left" data-path="left" data-riddle="1">← THE FIRST THREAD</button>
      <div class="riddle-cell">
        <div class="riddle-number">riddle two</div>
        <div class="riddle-text" id="riddle-1">The more you take, the more you leave behind. What am I?</div>
      </div>
      <button class="path-btn right" data-path="right" data-riddle="1">THE SECOND THREAD →</button>
    </div>

    <!-- Riddle 3 -->
    <div class="riddle-grid" data-riddle="2">
      <button class="path-btn left" data-path="left" data-riddle="2">← THE FIRST THREAD</button>
      <div class="riddle-cell">
        <div class="riddle-number">riddle three</div>
        <div class="riddle-text" id="riddle-2">I have cities, but no houses. I have mountains, but no trees. I have water, but no fish. What am I?</div>
      </div>
      <button class="path-btn right" data-path="right" data-riddle="2">THE SECOND THREAD →</button>
    </div>

    <button class="submit-btn" id="submitBtn" disabled>ATTEMPT ENTRY</button>
  </div>

  <script>
    // Frontgate Ritual: Three Riddles, Simultaneous Truth
    (() => {
      'use strict';

      const FAIL_MS = 3000;
      const FAIL_MESSAGES = [
        "the threads slip through your fingers.",
        "the pattern rejects your weaving.",
        "not quite. the loom remembers.",
        "intent fractured. try again.",
        "the sanctuary sighs. denied.",
        "your answers echo wrong.",
        "the gatekeeper yawns. reset.",
        "threads tangled. start anew.",
        "close. but the pattern demands truth.",
        "the vestibule is cold. return to start."
      ];

      // Riddle answers: 0 = left, 1 = right
      const ANSWERS = [0, 1, 0]; // echo, footsteps, map
      const RIDDLE_LABELS = [
        { left: "an echo", right: "a shadow" },
        { left: "footsteps", right: "memories" },
        { left: "a map", right: "a dream" }
      ];

      let selections = [-1, -1, -1];
      let state = 'ready'; // ready, checking, fail, cooldown
      let failTimer = 0;

      const grids = document.querySelectorAll('.riddle-grid');
      const pathBtns = document.querySelectorAll('.path-btn');
      const submitBtn = document.getElementById('submitBtn');
      const statusEl = document.getElementById('status');

      pathBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          if (state !== 'ready') return;

          const riddle = parseInt(btn.dataset.riddle, 10);
          const path = btn.dataset.path;

          // Deselect other button in same riddle
          grids[riddle].querySelectorAll('.path-btn').forEach(b => b.classList.remove('selected'));

          // Select this one
          btn.classList.add('selected');
          selections[riddle] = path === 'left' ? 0 : 1;

          // Update button texts to show the answer labels
          const labels = RIDDLE_LABELS[riddle];
          const leftBtn = grids[riddle].querySelector('[data-path="left"]');
          const rightBtn = grids[riddle].querySelector('[data-path="right"]');
          leftBtn.textContent = '← ' + labels.left.toUpperCase();
          rightBtn.textContent = labels.right.toUpperCase() + ' →';

          // Check if all three selected
          if (selections.every(s => s !== -1)) {
            submitBtn.disabled = false;
            submitBtn.classList.add('ready');
            statusEl.textContent = 'ALL THREE CHOSEN. ATTEMPT ENTRY.';
          }
        });
      });

      submitBtn.addEventListener('click', () => {
        if (state !== 'ready') return;

        state = 'checking';
        submitBtn.disabled = true;
        submitBtn.classList.remove('ready');
        statusEl.textContent = 'WEAVING...';

        // Small delay for dramatic effect
        setTimeout(() => {
          const correct = selections.every((s, i) => s === ANSWERS[i]);

          if (correct) {
            success();
          } else {
            fail();
          }
        }, 600);
      });

      function success() {
        state = 'success';
        statusEl.textContent = 'THE PATTERN HOLDS. WELCOME TO THE SANCTUM.';
        submitBtn.textContent = 'ENTERING...';
        submitBtn.style.borderColor = '#ff4d4d';
        submitBtn.style.background = 'rgba(255, 77, 77, 0.3)';

        setTimeout(() => {
          window.location.href = '/ZADDY-vibes/dmliZS1jb2xsZWN0aXZlcy1tYWluaGFsbC1zYW5jdHVt/';
        }, 1200);
      }

      function fail() {
        state = 'fail';
        const msg = FAIL_MESSAGES[Math.floor(Math.random() * FAIL_MESSAGES.length)];
        statusEl.textContent = msg.toUpperCase();
        statusEl.classList.add('cooldown');

        // Reset selections and UI
        selections = [-1, -1, -1];
        pathBtns.forEach(btn => {
          btn.classList.remove('selected');
          btn.disabled = true;
        });
        submitBtn.disabled = true;

        // Restore original button texts after a moment
        setTimeout(() => {
          RIDDLE_LABELS.forEach((labels, i) => {
            const grid = grids[i];
            const leftBtn = grid.querySelector('[data-path="left"]');
            const rightBtn = grid.querySelector('[data-path="right"]');
            leftBtn.textContent = '← THE FIRST THREAD';
            rightBtn.textContent = 'THE SECOND THREAD →';
          });
        }, 500);

        failTimer = setTimeout(() => {
          state = 'ready';
          statusEl.textContent = 'THREE RIDDLES. CHOOSE EACH PATH.';
          statusEl.classList.remove('cooldown');
          pathBtns.forEach(btn => btn.disabled = false);
        }, FAIL_MS);
      }
    })();
  </script>
</Layout>