---
// src/components/ui/label.astro
import { cn } from "../../lib/utils"

interface Props {
  class?: string
  [key: string]: any
}

const { class: className, ...rest } = Astro.props
const classList = cn("text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70", className)
---

<label class={classList} {...rest}>
  <slot />
</label>