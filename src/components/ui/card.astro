---
// src/components/ui/card.astro
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
  [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
const classList = cn(
  "rounded-lg border bg-card text-card-foreground shadow-sm",
  className,
);
---

<div class={classList} {...rest}>
  <slot />
</div>