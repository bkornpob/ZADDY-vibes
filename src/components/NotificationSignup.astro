---
// src/components/NotificationSignup.astro
import { cn } from "../lib/utils"
import Button from "./ui/button.astro"
import Input from "./ui/input.astro"
import Label from "./ui/label.astro"
import Card from "./ui/card.astro"
import CardContent from "./ui/card-content.astro"
import Checkbox from "./ui/checkbox.astro"

interface Props {
  projectSlug: string
  emailEnabled?: boolean
  discordEnabled?: boolean
  dmEnabled?: boolean
}

const { projectSlug, emailEnabled = true, discordEnabled = false, dmEnabled = false } = Astro.props
---

<Card class="border-border/50 mt-8">
  <CardContent class="pt-6">
    <div class="space-y-4">
      <h3 class="text-lg font-semibold flex items-center gap-2">
        <span class="text-muted-foreground">🔔</span> Stay Updated
      </h3>
      <p class="text-sm text-muted-foreground">
        Get notified when this project updates
      </p>
      
      {emailEnabled && (
        <form class="space-y-3" data-astro-cid={projectSlug} action="#email-signup" method="POST">
          <div class="space-y-2">
            <Label htmlFor={`email-${projectSlug}`} class="flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Email
            </Label>
            <div class="flex gap-2">
              <Input 
                id={`email-${projectSlug}`}
                type="email" 
                placeholder="your@email.com" 
                required 
                class="flex-1"
              />
              <Button type="submit" class="whitespace-nowrap">Subscribe</Button>
            </div>
            <p class="text-xs text-muted-foreground">Placeholder — connect to your email service (Formspree, Netlify Functions, etc.)</p>
          </div>
        </form>
      )}
      
      {discordEnabled && (
        <div class="space-y-2 border-t pt-4">
          <Label class="flex items-center gap-2">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.592 1.25a18.27 18.27 0 0 0-5.52 0 12.64 12.64 0 0 0-.592-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.03.072C3.6 9.304 5.283 13.8 8.456 17.54a.08.08 0 0 0 .12.076h7.09a.08.08 0 0 0 .12-.076c3.21-3.71 4.854-8.227 4.804-13.168a.066.066 0 0 0-.029-.068m-5.99 16.09c-.916-.954-1.529-3.318-.652-7.089a13.882 13.882 0 0 1 1.008N12 8.78a13.79 13.79 0 0 1 1.33.002c.887 3.736.274 6.1.652 7.09zm-2.07-7.992c-.617.54-2.044 1.97-2.187 2.151a.5.5 0 1 1-.862-.797c.252-.327 1.794-1.868 3.05-1.354a.5.5 0 1 1 .775.798zm-6.986-.007c1.038-.426 2.592.887 2.844 1.354a.5.5 0 1 1-.775.798c-.162-.2-1.633-1.75-2.173-2.15a.5.5 0 0 1-.873-.798z"/>
            </svg>
            Discord
          </Label>
          <Button variant="outline" class="w-full justify-start" disabled>
            <svg class="h-4 w-4 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.592 1.25a18.27 18.27 0 0 0-5.52 0 12.64 12.64 0 0 0-.592-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.03.072C3.6 9.304 5.283 13.8 8.456 17.54a.08.08 0 0 0 .12.076h7.09a.08.08 0 0 0 .12-.076c3.21-3.71 4.854-8.227 4.804-13.168a.066.066 0 0 0-.029-.068m-5.99 16.09c-.916-.954-1.529-3.318-.652-7.089a13.882 13.882 0 0 1 1.008N12 8.78a13.79 13.79 0 0 1 1.33.002c.887 3.736.274 6.1.652 7.09zm-2.07-7.992c-.617.54-2.044 1.97-2.187 2.151a.5.5 0 1 1-.862-.797c.252-.327 1.794-1.868 3.05-1.354a.5.5 0 1 1 .775.798zm-6.986-.007c1.038-.426 2.592.887 2.844 1.354a.5.5 0 1 1-.775.798c-.162-.2-1.633-1.75-2.173-2.15a.5.5 0 0 1-.873-.798z"/>
            </svg>
            Join Discord (placeholder)
          </Button>
          <p class="text-xs text-muted-foreground">Placeholder — add Discord webhook/role assignment</p>
        </div>
      )}
      
      {dmEnabled && (
        <div class="space-y-2 border-t pt-4">
          <Label class="flex items-center gap-2">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            Direct Message
          </Label>
          <Button variant="outline" class="w-full justify-start" disabled>
            <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            Send DM (placeholder)
          </Button>
          <p class="text-xs text-muted-foreground">Placeholder — configure DM endpoint (Telegram bot, Matrix, custom)</p>
        </div>
      )}
    </div>
  </CardContent>
</Card>

<script is:inline>
  document.querySelectorAll(`form[data-astro-cid="${projectSlug}"]`).forEach(form => {
    form.addEventListener("submit", (e) => {
      e.preventDefault()
      const input = form.querySelector("input[type=email]")
      if (input?.value) {
        alert(`Email signup for ${projectSlug}: ${input.value} — connect your backend!`)
        input.value = ""
      }
    })
  })
</script>